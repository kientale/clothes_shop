# Copy to .env (never commit it). Spring Boot reads .env automatically via spring.config.import.

# --- Supabase (the Session pooler copied from this project's Connect dialog) ---
# Spring JDBC uses a jdbc:postgresql URL; credentials are separate properties.
# DB_PASSWORD is the original password, not percent-encoded (even when it contains @).
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connectTimeout=10&tcpKeepAlive=true
DB_USERNAME=postgres.wfhwedjxlgpggrlcfhkh
DB_PASSWORD=replace-with-your-database-password
DB_POOL_SIZE=5
# Milliseconds to keep retrying the first database connection at startup (pooler hiccups).
DB_INIT_FAIL_TIMEOUT=60000

# Uncomment to load the demo data (docs/demo-seed.md) on startup.
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# --- Local Docker Postgres (docker compose up -d postgres) ---
# DB_URL=jdbc:postgresql://localhost:5432/clothes
# DB_USERNAME=clothes
# DB_PASSWORD=clothes_local

# Replace with an independently generated secret of at least 32 UTF-8 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Origin used in uploaded-file URLs (e.g. https://admin.example.com); empty = origin of the upload request.
UPLOADS_PUBLIC_BASE_URL=

# Customer emails (password reset, order confirmation). Leave MAIL_HOST empty to only log them (development).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@lemonadex.vn
MAIL_FROM_NAME=LemonadeX
# Public shop address used in email links and the sitemap.
STOREFRONT_URL=http://localhost:3000

# Per-client limits on sign-in, sign-up, password reset, checkout and order lookup (in memory, one instance).
RATE_LIMIT_ENABLED=true
# Set to native behind a reverse proxy so the limits use the real client address.
FORWARD_HEADERS_STRATEGY=none

# --- Google / Facebook sign-in (buttons appear only when set) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Online payments (also switch VNPAY / MOMO on in admin > payment settings) ---
# Public origin of this backend; MoMo calls <origin>/api/v1/payments/momo/ipn.
PAYMENT_CALLBACK_BASE_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# --- Giao Hàng Tiết Kiệm (without a token the GHTK method charges its fixed fee) ---
GHTK_TOKEN=
# GHTK_BASE_URL=https://services.giaohangtietkiem.vn
# Register .../api/v1/carriers/ghtk/webhook?hash=<this value> as the GHTK webhook.
GHTK_WEBHOOK_SECRET=
GHTK_PICK_NAME=
GHTK_PICK_TEL=
GHTK_PICK_ADDRESS=
GHTK_PICK_PROVINCE=
GHTK_PICK_DISTRICT=
GHTK_PICK_WARD=
GHTK_ITEM_WEIGHT_GRAMS=300

# How often back-in-stock emails are checked (ISO-8601 duration).
STOCK_ALERT_INTERVAL=PT5M
