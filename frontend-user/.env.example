# Vite dev proxy destination. Restart npm run dev after changing this value.
VITE_API_PROXY_TARGET=http://localhost:8080
# Leave empty to use same-origin /api/v1 (dev proxy or production reverse proxy).
# To call the backend directly, set its origin, e.g. http://localhost:8080.
VITE_API_BASE_URL=
# Optional: Google Maps Platform key (Places API New + Geocoding API) for checkout address search.
# Leave empty to use the free OpenStreetMap (Photon) lookup instead. Restrict the key to your domain.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: error reporting with Sentry (project DSN) and visit statistics with Google Analytics 4 (G-XXXXXXX).
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=
